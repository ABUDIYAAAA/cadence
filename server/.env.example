PORT=8080
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=lms
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Connection Strings
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# SMTP Settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cadence.local
SMTP_FROM_NAME=Cadence
SMTP_SSL=false

# JWT Settings
JWT_ACCESS_SECRET=cadence_super_secret_jwt_access_key_12345
JWT_REFRESH_SECRET=cadence_super_secret_jwt_refresh_key_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Cookie Settings (Cookie signing secret + parameters)
COOKIE_SECRET=cadence_super_secret_cookie_signing_key_abcde
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_EXPIRY=15m
REFRESH_COOKIE_EXPIRY=168h

# Admin Seeder
SEED_ADMIN_EMAIL=admin@cadence.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_NAME=System Admin

# Web Push VAPID Settings
VAPID_PUBLIC_KEY=BHK-KDYnjw1Z0O844tmUWbz3m7OT8faBNZ8P0se6qjeqqnuIhtJa4zU-XyFfre29bHMUCQaW6hw5Ck4R20H6ziQ
VAPID_PRIVATE_KEY=GWjhiHXmi8zODFg6GOGY4sN1SyAdkI8Kb-kalR15nfU
VAPID_SUBJECT=mailto:admin@cadence.local

# Telemetry & Scrape Security
METRICS_SCRAPE_TOKEN=cadence_metrics_secret_scrape_token_987654

# Scheduled DB Backups to Cloudflare R2 (leave R2_BUCKET empty to disable)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override endpoint host (defaults to <R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
BACKUP_INTERVAL=30m
BACKUP_PREFIX=db-backups
# Optional: delete backups older than this (e.g. 168h = 7 days). Empty keeps everything.
BACKUP_RETENTION=

# Grafana Telemetry & Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001

# Prometheus Configuration (Internal localhost only)
PROMETHEUS_PORT=9090

